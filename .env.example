# --- Base de données ---
DATABASE_URL=postgresql+psycopg://tontine:tontine@db:5432/tontine
POSTGRES_USER=tontine
POSTGRES_PASSWORD=tontine
POSTGRES_DB=tontine

# --- Cache et file de tâches ---
REDIS_URL=redis://redis:6379/0

# --- Authentification ---
# Générer avec : openssl rand -hex 32
JWT_SECRET=change-moi-absolument-en-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Limitation de débit ---
# Deux seaux sur la connexion : par adresse contre le balayage de numéros,
# par numéro contre l'acharnement sur un seul compte.
LOGIN_MAX_PAR_ADRESSE=20
LOGIN_MAX_PAR_NUMERO=5
LOGIN_FENETRE_SECONDES=300
REGISTER_MAX_PAR_ADRESSE=5
REGISTER_FENETRE_SECONDES=3600

# --- MTN Mobile Money (sandbox) ---
# Créer un compte sur https://momodeveloper.mtn.com puis souscrire aux
# produits Collection et Disbursement pour obtenir ces clés.
# Laisser MOMO_SUBSCRIPTION_KEY vide fait tourner l'API sur un client simulé.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# Une clé par produit : s'abonner à Collection ne donne aucun droit sur
# Disbursement. MOMO_SUBSCRIPTION_KEY sert de repli si un seul produit est
# souscrit ; les clés spécifiques l'emportent quand elles sont renseignées.
MOMO_SUBSCRIPTION_KEY=
MOMO_COLLECTION_KEY=
MOMO_DISBURSEMENT_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CALLBACK_SECRET=change-moi-aussi
# MTN n'enregistre qu'un hôte de callback, sans chemin : cette URL complète est
# envoyée à chaque appel de paiement. Sans elle, aucun callback n'arrive.
MOMO_CALLBACK_URL=

# --- Front ---
VITE_API_URL=http://localhost:8000/api/v1

# --- Production ---
# Origines autorisées à appeler l'API, séparées par des virgules.
# Jamais "*" : les requêtes portent des identifiants.
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
